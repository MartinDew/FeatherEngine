# clang-tidy config for FeatherEngine. Tuned against how this codebase is actually written (see
# core/ecs, core/main/class_db.*) rather than taken as generic C++ Core Guidelines advice -- several
# checks are disabled because the pattern they flag is this project's deliberate design, not a slip:
#
#   - FSTRUCT/FCLASS components are plain structs with public fields by design (reflection binds
#     them directly), so the "make members private" family is noise here.
#   - The reflection/ECS macros (FCLASS, FSTRUCT, FEATHER_API, FSINGLETON_*) are the whole point of
#     core/framework/reflection_macros.h, so "avoid macros" is noise here too.
#   - World's raw memory layer (component.cpp, world.cpp, system_iterator.h) does pointer arithmetic,
#     reinterpret_cast and process-lifetime `new` on purpose -- that's what a component store is.
#   - CowVector/StaticIndexedArray hand-roll allocation and operator[] for performance; every hot-path
#     container in core/framework does the same, so the bounds/malloc/do-while guidance is noise there.
#   - StaticString is a non-owning view passed by value everywhere on purpose (it's pointer-sized);
#     "pass by const&" advice is backwards for it, and math_defs.h's vector types use unions on purpose.
#
# Header filtering intentionally leaves out thirdparty/ (vendored, not ours to fix) and *.gen.h /
# *.gen.cpp (generated by tools/codegen/generate_reflection.py; never hand-edited, see CLAUDE.md).
---
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-no-malloc,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-const-cast,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-special-member-functions,
  misc-*,
  -misc-header-include-cycle,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  modernize-*,
  -modernize-avoid-c-arrays,
  -modernize-use-designated-initializers,
  -modernize-use-nodiscard,
  -modernize-use-trailing-return-type,
  performance-*,
  -performance-unnecessary-value-param,
  portability-*,
  -portability-avoid-pragma-once,
  readability-*,
  -readability-braces-around-statements,
  -readability-identifier-length,
  -readability-implicit-bool-conversion,
  -readability-magic-numbers,
  -readability-uppercase-literal-suffix

WarningsAsErrors: ''

HeaderFilterRegex: '[/\\](core|modules|tools)[/\\].*\.(h|hpp|inl)$'
ExcludeHeaderFilterRegex: '(thirdparty|\.gen\.(h|hpp))'

FormatStyle: file

CheckOptions:
  # feather, ecs_detail.
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  # World, EntityId, ClassInfo, ValueTypeOps. iterator/const_iterator (CowVector) are exempt because
  # those exact names are what range-based for and <algorithm> require -- not a style choice to flag.
  # _class_type is FCLASS/FSTRUCT's own injected boilerplate (reflection_macros.h), present in every
  # reflected class in the codebase; it is generated, not written, so it isn't ours to rename either.
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.ClassIgnoredRegexp
    value: '^(iterator|const_iterator|reverse_iterator|const_reverse_iterator)$'
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.StructIgnoredRegexp
    value: '^_class_type$'
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  # SystemPhase::OnLoad, TermAccess::In -- the newer ECS enums. VariantType predates this convention
  # (NIL, BOOL, INT, ...) and will show as violations; that split is real, not a config mistake.
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  # using Type = Reflected; using SystemCallback = void(*)(...). The ignored names are the two cases
  # that can't be CamelCase: STL container/iterator protocol names (value_type, pointer, ...) are
  # fixed by the standard, and the project's own _t-suffixed aliases (real_t, id_t) copy size_t/time_t.
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  - key: readability-identifier-naming.TypeAliasIgnoredRegexp
    value: '^(value_type|pointer|const_pointer|reference|const_reference|iterator_category|difference_type|size_type|[a-z][a-z0-9_]*_t)$'
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  # is_valid, create_entity (public) vs _begin_module, _find_property (private/protected): the leading
  # underscore is this project's "internal, not public API" marker on methods too, not just members
  # (see World's own _-prefixed private methods) -- MethodCase has no per-access-level prefix option,
  # so the underscore-prefixed form is allowed via the ignored pattern rather than left unenforced.
  - key: readability-identifier-naming.MethodCase
    value: lower_case
  - key: readability-identifier-naming.MethodIgnoredRegexp
    value: '^_[a-z][a-z0-9_]*$'
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  # _impl, _components, _current_info -- the leading underscore is this project's "internal, treat
  # as private" marker (see World's own _-prefixed private methods) and holds even where a companion
  # class is friended instead of the member being made public.
  - key: readability-identifier-naming.PrivateMemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: _
  - key: readability-identifier-naming.ProtectedMemberCase
    value: lower_case
  - key: readability-identifier-naming.ProtectedMemberPrefix
    value: _
  # Public fields on FSTRUCT components (Light::type, Scene::_scene_id). No prefix is enforced here:
  # Scene::_scene_id is public but underscore-prefixed on purpose (reflection-only access), which is
  # exactly the same convention as the private members above -- just applied to a public field.
  - key: readability-identifier-naming.PublicMemberCase
    value: lower_case
  # Engine::simulation_time: a named constant, still snake_case -- ALL_CAPS is reserved for macros.
  - key: readability-identifier-naming.ClassConstantCase
    value: lower_case
  - key: readability-identifier-naming.StaticConstantCase
    value: lower_case
  - key: readability-identifier-naming.GlobalConstantCase
    value: lower_case
  - key: readability-identifier-naming.GlobalVariableCase
    value: lower_case
  # FEATHER_API, FCLASS, BETA, EDITOR_BUILD.
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
